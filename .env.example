# ── General ──────────────────────────────────────────────
ENVIRONMENT=production
TZ=Africa/Kigali

# ── Backend ────────────────────────────────────────────────
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ── Uploads ──────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=20

# ── VAT ──────────────────────────────────────────────────
VAT_RATE=0.18

# ── Rate limiting ────────────────────────────────────────
RATE_LIMIT_GENERATE=20/minute

# ── Frontend ─────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000/api
